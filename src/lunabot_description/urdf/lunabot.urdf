<?xml version="1.0"?>
<robot name="lunabot">

  <!-- ========================= -->
  <!-- MAIN CHASSIS              -->
  <!-- ========================= -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="2.4 1.4 0.35"/>
      </geometry>
      <material name="chassis_gray">
        <color rgba="0.35 0.35 0.38 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="2.4 1.4 0.35"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="20"/>
      <inertia ixx="5" ixy="0" ixz="0"
               iyy="5" iyz="0"
               izz="5"/>
    </inertial>
  </link>


  <!-- ========================= -->
  <!-- FRONT LEFT WHEEL - FL     -->
  <!-- ========================= -->

  <link name="wheel_fl">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.28" length="0.16"/>
      </geometry>
      <material name="wheel_dark">
        <color rgba="0.08 0.08 0.09 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.28" length="0.16"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="2"/>
      <inertia ixx="0.1" ixy="0" ixz="0"
               iyy="0.1" iyz="0"
               izz="0.1"/>
    </inertial>
  </link>

  <joint name="wheel_fl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fl"/>
    <origin xyz="0.9 0.76 0.0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ========================= -->
  <!-- FRONT RIGHT WHEEL - FR    -->
  <!-- ========================= -->

  <link name="wheel_fr">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.28" length="0.16"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.28" length="0.16"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="2"/>
      <inertia ixx="0.1" ixy="0" ixz="0"
               iyy="0.1" iyz="0"
               izz="0.1"/>
    </inertial>
  </link>

  <joint name="wheel_fr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fr"/>
    <origin xyz="0.9 -0.76 0.0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ========================= -->
  <!-- MIDDLE LEFT WHEEL - ML    -->
  <!-- ========================= -->

  <link name="wheel_ml">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.28" length="0.16"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.28" length="0.16"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="2"/>
      <inertia ixx="0.1" ixy="0" ixz="0"
               iyy="0.1" iyz="0"
               izz="0.1"/>
    </inertial>
  </link>

  <joint name="wheel_ml_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_ml"/>
    <origin xyz="0 0.76 0.0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ========================= -->
  <!-- MIDDLE RIGHT WHEEL - MR   -->
  <!-- ========================= -->

  <link name="wheel_mr">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.28" length="0.16"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.28" length="0.16"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="2"/>
      <inertia ixx="0.1" ixy="0" ixz="0"
               iyy="0.1" iyz="0"
               izz="0.1"/>
    </inertial>
  </link>

  <joint name="wheel_mr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_mr"/>
    <origin xyz="0 -0.76 0.0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ========================= -->
  <!-- REAR LEFT WHEEL - RL      -->
  <!-- ========================= -->

  <link name="wheel_rl">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.28" length="0.16"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.28" length="0.16"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="2"/>
      <inertia ixx="0.1" ixy="0" ixz="0"
               iyy="0.1" iyz="0"
               izz="0.1"/>
    </inertial>
  </link>

  <joint name="wheel_rl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rl"/>
    <origin xyz="-0.9 0.76 0.0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ========================= -->
  <!-- REAR RIGHT WHEEL - RR     -->
  <!-- ========================= -->

  <link name="wheel_rr">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.28" length="0.16"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.28" length="0.16"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="2"/>
      <inertia ixx="0.1" ixy="0" ixz="0"
               iyy="0.1" iyz="0"
               izz="0.1"/>
    </inertial>
  </link>

  <joint name="wheel_rr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rr"/>
    <origin xyz="-0.9 -0.76 0.0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ========================= -->
  <!-- TOP PLATFORM              -->
  <!-- ========================= -->

  <link name="top_platform">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="1.8 1.1 0.15"/>
      </geometry>
      <material name="platform">
        <color rgba="0.55 0.55 0.58 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="1.8 1.1 0.15"/>
      </geometry>
    </collision>
  </link>

  <joint name="top_platform_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_platform"/>
    <origin xyz="0 0 0.25"/>
  </joint>


  <!-- ========================= -->
  <!-- CAMERA / SENSOR MAST      -->
  <!-- ========================= -->

  <link name="camera_mast">
    <visual>
      <origin xyz="0 0 0.45"/>
      <geometry>
        <cylinder radius="0.07" length="0.9"/>
      </geometry>
      <material name="mast">
        <color rgba="0.25 0.25 0.28 1"/>
      </material>
    </visual>
  </link>

  <joint name="camera_mast_joint" type="fixed">
    <parent link="top_platform"/>
    <child link="camera_mast"/>
    <origin xyz="0 0 0.1"/>
  </joint>


  <!-- ========================= -->
  <!-- CAMERA HEAD               -->
  <!-- ========================= -->

  <link name="front_camera">
    <visual>
      <origin xyz="0.12 0 0"/>
      <geometry>
        <box size="0.25 0.25 0.18"/>
      </geometry>
      <material name="camera_black">
        <color rgba="0.02 0.02 0.02 1"/>
      </material>
    </visual>
  </link>

  <joint name="front_camera_joint" type="fixed">
    <parent link="camera_mast"/>
    <child link="front_camera"/>
    <origin xyz="0 0 0.9"/>
  </joint>


  <!-- ========================= -->
  <!-- LIDAR SENSOR              -->
  <!-- ========================= -->

  <link name="lidar">
    <visual>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
      <material name="lidar_blue">
        <color rgba="0.1 0.3 0.8 1"/>
      </material>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="top_platform"/>
    <child link="lidar"/>
    <origin xyz="0 0 0.2"/>
  </joint>

  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      
      <left_joint>wheel_fl_joint</left_joint>
      <left_joint>wheel_ml_joint</left_joint>
      <left_joint>wheel_rl_joint</left_joint>

      <right_joint>wheel_fr_joint</right_joint>
      <right_joint>wheel_mr_joint</right_joint>
      <right_joint>wheel_rr_joint</right_joint>

      <wheel_separation>1.52</wheel_separation>
      <wheel_radius>0.28</wheel_radius>

      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

    </plugin>
  </gazebo>
</robot>
